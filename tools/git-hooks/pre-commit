#!/usr/bin/env bash
# Vor jedem Commit: Fassung hochzählen (nur neue Kennung, wenn version.json schon vorgemerkt ist) und vormerken, dann die
# vorgemerkten Dateien prüfen (nur gerade Zeichen; Stil ohne !important, einseitige Streifen und Regeln auf Klassen der
# Schale; nur Marken der Gestaltung, scharf nach gestaltung.toml). Die Prüfungen stehen an einer Stelle im Appkern
# (appkern.werkzeuge).
set -euo pipefail
# >>> handbuch: Seite und Einrichtungsskript prüfen (eingesetzt von "handbuch einbinden", nicht von Hand ändern)
handbuch_befehl="$(command -v handbuch || true)"
[ -n "$handbuch_befehl" ] || handbuch_befehl="$HOME/.local/bin/handbuch"
if [ ! -x "$handbuch_befehl" ]; then
  echo "Abbruch: das Werkzeug handbuch fehlt (Handbuch, Grundlage Mac)" >&2
  exit 1
fi
"$handbuch_befehl" vor-commit "$(git rev-parse --show-toplevel)" || exit 1
# <<< handbuch
cd "$(git rev-parse --show-toplevel)"
exec .venv/bin/python -m appkern.werkzeuge vor-dem-commit
